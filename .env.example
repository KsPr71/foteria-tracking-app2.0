# Copia este archivo a .env y rellena los valores.
# cp .env.example .env

# Microservicio de notificaciones (Render). URL base sin / final.
# Si no se define, la app no registrará tokens ni sincronizará órdenes con el servicio.
# EXPO_PUBLIC_NOTIFICATION_SERVICE_URL=https://tu-app.onrender.com

# Otras variables que la app puede usar (oauth, supabase, etc.):
# EXPO_PUBLIC_OAUTH_SERVER_URL=
# EXPO_PUBLIC_OAUTH_PORTAL_URL=
# EXPO_PUBLIC_APP_ID=
# EXPO_PUBLIC_OWNER_OPEN_ID=
# EXPO_PUBLIC_OWNER_NAME=
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=
