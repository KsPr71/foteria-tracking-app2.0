# URL del JSON de órdenes (Supabase)
SUPABASE_ORDERS_URL=https://lcuaqykvynaqtyqofdsv.supabase.co/storage/v1/object/public/datos/datos-ordenes.json

# Puerto del API
PORT=3100

# Intervalo del cron en minutos (verificar cambios de estado)
CRON_INTERVAL_MINUTES=10

# Ruta de la base SQLite (directorio se crea si no existe)
DB_PATH=./data/notifications.db

# Opcional: Access token de Expo para mayor seguridad (EAS Dashboard)
# EXPO_ACCESS_TOKEN=

# Entorno
NODE_ENV=development
