# Firebase: cuenta de servicio (JSON como string).
# Obtener en Firebase Console → Project Settings → Service accounts → Generate new private key.
# En Render: pegar el JSON completo como valor de esta variable.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Alternativa local: archivo de credenciales y variable de entorno
# GOOGLE_APPLICATION_CREDENTIALS=./credenciales.json

# URL del JSON de órdenes (Supabase)
SUPABASE_ORDERS_URL=https://lcuaqykvynaqtyqofdsv.supabase.co/storage/v1/object/public/datos/datos-ordenes.json

# Puerto del API (en Render lo asigna la plataforma)
PORT=3100

# Intervalo del cron en minutos (solo informativo; quien dispara es cron-job.org)
CRON_INTERVAL_MINUTES=10

# Secreto para proteger /api/cron. Generar una cadena aleatoria larga.
# Cron-job.org enviará ?secret=XXX o header X-Cron-Secret: XXX.
CRON_SECRET=tu_secreto_largo_y_aleatorio

# Opcional: token EAS para push (Expo)
# EXPO_ACCESS_TOKEN=

# Entorno
NODE_ENV=development
